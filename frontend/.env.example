# Copie para frontend/.env e ajuste. O .env NÃO é versionado.
#
# "mock": todo pagamento é aprovado na hora, sem chamar API externa (use para avaliar o projeto).
# "mercadopago": Pix real no sandbox do Mercado Pago (exige as duas chaves abaixo).
PAYMENT_MODE=mock

# Só no modo mercadopago (credenciais de TESTE geradas no painel do Mercado Pago):
# MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY=

# 0 desliga os clientes fictícios, o histórico de 60 dias e as rotas /demo/*
# DEMO_MODE=1

# ---- NÃO vão neste arquivo (são variáveis de ambiente do processo, lidas pelo backend) ----
# HARDWARE_MODE=modbus   liga o Modbus TCP (use o simulador: ver README, seção "Como executar")
# HARDWARE_HOST / HARDWARE_PORT   padrão 127.0.0.1 / 5020
# CHARGEGRID_API_KEY     chave da API; run.sh/run.bat geram uma aleatória por execução
